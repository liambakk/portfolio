# Large video files
public/mp4/

# Large unoptimized previews (using optimized versions instead)
public/previews/

# Large PDF files  
public/pdf/

# Large unoptimized original images (using optimized versions instead)
public/*.png
public/*.jpg
public/*.gif

# Allow specific GIFs that are needed for Neura project demos
!public/neura.gif
!public/neurabox.gif

# Allow specific large images needed for projects
!public/relaycolors.png
!public/relayofull.png
!public/relaydesign.png
!public/poapdesign.png

# Development files not needed for deployment
node_modules/
.next/
.git/
scripts/

# Keep optimized image directories
!public/previews-optimized/
!public/project-images-optimized/
!public/remaining-images-optimized/

# Keep essential SVG icons
!public/*.svg